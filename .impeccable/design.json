  "components": [
    {
      "name": "세이지 주요 버튼",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "종이 패널 층의 저장, 확인 같은 주요 행동.",
      "html": "<button class=\"ds-btn-primary\">저장하기</button>",
      "css": ".ds-btn-primary{font-family:'Gowun Dodum',sans-serif;font-size:16px;background:var(--sage,#6c7b61);border:2px solid #49533f;color:#fff5e4;box-shadow:inset 2px 2px #98a184,0 2px #d1b899;border-radius:5px;padding:10px 18px;cursor:pointer;transition:background .15s,transform .15s}.ds-btn-primary:hover{filter:brightness(1.06)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid #9b70bc;outline-offset:4px}"
    },
    {
      "name": "보조 버튼",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "취소, 나중에 하기 같은 두 번째 행동.",
      "html": "<button class=\"ds-btn-secondary\">나중에 할게요</button>",
      "css": ".ds-btn-secondary{font-family:'Gowun Dodum',sans-serif;font-size:16px;background:#fff8e8;border:2px solid #b6a084;color:#49533f;border-radius:5px;padding:10px 18px;cursor:pointer;transition:background .15s,transform .15s}.ds-btn-secondary:hover{filter:brightness(1.06)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:3px solid #9b70bc;outline-offset:4px}"
    },
    {

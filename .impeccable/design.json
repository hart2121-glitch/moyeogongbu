      "html": "<div class=\"ds-wall\"><button class=\"ds-desk-go\">출근</button></div>",
      "css": ".ds-wall{background:#2b201c;padding:24px}.ds-desk-go{font-family:'Gowun Dodum',sans-serif;font-size:16px;background:#7d55a0;box-shadow:inset -3px -3px 0 0 #5c3d78;color:#fff8e8;border:0;border-radius:0;padding:7px 14px;cursor:pointer;transition:transform .15s}.ds-desk-go:hover{filter:brightness(1.06)}.ds-desk-go:active{transform:translateY(1px)}.ds-desk-go:focus-visible{outline:3px solid #b892d8;outline-offset:3px}"
    },
    {
      "name": "입력칸",
      "kind": "input",
